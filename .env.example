# Copy this file to .env and adjust as needed.
# All values here have sane defaults in app/config.py; you only need to
# set the ones you want to override.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://route_optimizer:route_optimizer@localhost:5432/route_optimizer

# --- API / CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- OSM ingestion / caching ---
GRAPH_CACHE_DIR=data/graph_cache
DEFAULT_NETWORK_RADIUS_BUFFER_M=400.0
OSM_NETWORK_TYPE=walk
CACHE_COVERAGE_MARGIN_M=250.0

# --- Elevation ---
ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup
ELEVATION_API_BATCH_SIZE=100
ELEVATION_API_TIMEOUT_S=15.0
ELEVATION_CACHE_PATH=data/elevation_cache.json
ELEVATION_API_MAX_RETRIES=3
ELEVATION_API_BACKOFF_BASE_S=1.0
ELEVATION_API_BACKOFF_MAX_S=20.0

# --- Route generation bounds ---
MIN_TARGET_DISTANCE_MILES=0.5
MAX_TARGET_DISTANCE_MILES=15.0
MAX_ELEVATION_GAIN_FT=3000.0
NUM_CANDIDATE_ROUTES=12
MAX_DISTANCE_OVERSHOOT_FRACTION=0.35
MAX_LOOP_CLOSURE_FRACTION=0.15

# --- Scoring weights (see docs/OPTIMIZATION.md) ---
DISTANCE_ERROR_WEIGHT=1.0
ELEVATION_ERROR_WEIGHT=0.8
DIFFICULTY_PENALTY_WEIGHT=0.2
INVALID_CONSTRAINT_PENALTY=5.0

# --- Difficulty / pace ---
DIFFICULTY_NORMALIZATION_FT_PER_MILE=150.0
DEFAULT_PACE_MIN_PER_MILE=10.0
ELEVATION_TIME_PENALTY_MIN_PER_100FT=1.0

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=route_optimizer
POSTGRES_PASSWORD=route_optimizer
POSTGRES_DB=route_optimizer
